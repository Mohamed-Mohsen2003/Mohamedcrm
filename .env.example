# PostgreSQL connection string. Leave empty to run on the embedded PGlite database
# (stored in ./.data locally, in-memory on serverless) — perfect for demos.
DATABASE_URL=

# Secret used to sign session tokens. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the deployment, used for SEO metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When "true", the database is re-seeded with demo data on boot if it is empty.
DEMO_MODE=true
